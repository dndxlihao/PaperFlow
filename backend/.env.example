# Flask
SECRET_KEY=your-secret-key-at-least-32-characters
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/paper_hub?charset=utf8mb4

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Elsevier API (optional; improves some ScienceDirect PDF download paths)
ELSEVIER_API_KEY=

# Elsevier download browser fallback (recommended on campus network)
ELSEVIER_SELENIUM_FALLBACK=1
ELSEVIER_SELENIUM_HEADLESS=1
ELSEVIER_SELENIUM_USE_PROFILE=0
ELSEVIER_SELENIUM_MANUAL_WAIT_SECONDS=0
ELSEVIER_SELENIUM_TIMEOUT=180
ELSEVIER_SELENIUM_ATTACH_DEBUGGER=0
ELSEVIER_CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222
ELSEVIER_SELENIUM_ALLOW_NEW_BROWSER_ON_ATTACH_FAIL=1
ELSEVIER_SELENIUM_INTERACTIVE_VERIFY=1
ELSEVIER_SELENIUM_VERIFY_WAIT_SECONDS=300
# Optional: local Chrome profile settings when use_profile=1
# ELSEVIER_CHROME_USER_DATA_DIR=
# ELSEVIER_CHROME_PROFILE_DIR=Default

# PDF download retry queue
PDF_RETRY_ENABLED=1
PDF_RETRY_INTERVAL_MINUTES=120
PDF_RETRY_BATCH_SIZE=8
PDF_RETRY_MAX_ATTEMPTS=8
PDF_RETRY_BACKOFF_MINUTES=15,60,180,720,1440

# Recommendation scheduler
RECOMMEND_HOUR=8
RECOMMEND_MINUTE=0
CHANNEL_MONITOR_INTERVAL_MINUTES=60

# Optional: email reminder for digest
DIGEST_EMAIL_ENABLED=1
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-from-email@example.com
SMTP_USE_TLS=1

# Knowledge index weekly rebuild (Asia/Shanghai)
KNOWLEDGE_INDEX_ENABLED=1
KNOWLEDGE_INDEX_WEEKLY_DAY=sun
KNOWLEDGE_INDEX_HOUR=4
KNOWLEDGE_INDEX_MINUTE=30

# Knowledge trends weekly snapshot refresh (Asia/Shanghai)
KNOWLEDGE_TRENDS_ENABLED=1
KNOWLEDGE_TRENDS_WEEKLY_DAY=sun
KNOWLEDGE_TRENDS_HOUR=5
KNOWLEDGE_TRENDS_MINUTE=0
